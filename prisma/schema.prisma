// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====================
// ENUMS
// ====================

enum Role {
  FARMER
  BUYER
  EXPERT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  DELETED
}

enum AuthProvider {
  GOOGLE
  CREDENTIAL
}

enum CropStatus {
  PLANNED
  GROWING
  HARVESTED
}

enum ProductStatus {
  ACTIVE
  SOLD_OUT
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAID
  PROCESSING
  SHIPPED
  COMPLETED
  DELIVERED
  CANCELLED
  REFUNDED
  CONFIRMED
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentProvider {
  STRIPE
}

// ====================
// USER
// ====================

model User {
  id                 String         @id @default(uuid())
  name               String
  email              String         @unique
  password           String?
  phone              String?
  address            String?
  image              String?
  googleId           String?        @unique
  authProvider       AuthProvider   @default(CREDENTIAL)
  emailVerified      Boolean        @default(false)
  role               Role           @default(BUYER)
  status             UserStatus     @default(ACTIVE)
  needPasswordChange Boolean        @default(false)
  isDeleted          Boolean        @default(false)
  deletedAt          DateTime?
  expertAdvices      ExpertAdvice[]
  farmer             Farmer?
  buyer              Buyer?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

// ====================
// FARMER MODEL
// ====================

model Farmer {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  certification String?
  userId        String         @unique
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  farms         Farm[]
  products      Product[]
  consultations Consultation[]
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

// ====================
// BUYER MODEL
// ====================

model Buyer {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  address   String?
  city      String?
  country   String?
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders    Order[]
  reviews   Review[]
  payments  Payment[]
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ====================
// FARM
// ====================

model Farm {
  id        String    @id @default(uuid())
  farmName  String
  location  String
  landSize  Float?
  soilType  String?
  farmerId  String
  farmer    Farmer    @relation(fields: [farmerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  crops     Crop[]
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ====================
// CROP
// ====================

model Crop {
  id           String     @id @default(uuid())
  name         String
  variety      String?
  plantingDate DateTime?
  harvestDate  DateTime?
  status       CropStatus @default(PLANNED)
  farmId       String
  farm         Farm       @relation(fields: [farmId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isDeleted    Boolean    @default(false)
  deletedAt    DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

// ====================
// CATEGORY
// ====================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  image       String?
  products    Product[]
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ====================
// PRODUCT
// ====================

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?
  price       Int
  quantity    Float
  unit        String        @default("KG")
  image       String?
  status      ProductStatus @default(ACTIVE)
  farmerId    String
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  farmer      Farmer        @relation(fields: [farmerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems  OrderItem[]
  reviews     Review[]
  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// ====================
// EXPERT ADVICE
// ====================

model ExpertAdvice {
  id             String       @id @default(uuid())
  diagnosis      String
  recommendation String
  fertilizer     String?
  pesticide      String?
  consultationId String       @unique
  expertId       String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  expert         User         @relation(fields: [expertId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isDeleted      Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ====================
// CONSULTATION
// ====================

model Consultation {
  id        String             @id @default(uuid())
  cropName  String?
  problem   String
  image     String?
  status    ConsultationStatus @default(PENDING)
  advice    ExpertAdvice?
  farmerId  String
  farmer    Farmer             @relation(fields: [farmerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isDeleted Boolean            @default(false)
  deletedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// ====================
// ORDER
// ====================

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  totalAmount     Int
  deliveryAddress String
  status          OrderStatus @default(PENDING)
  buyerId         String
  farmerId        String
  buyer           Buyer       @relation(fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderItems      OrderItem[]
  reviews         Review[]
  payment         Payment?
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// =========================
// ORDER ITEM
// =========================

model OrderItem {
  id        String    @id @default(uuid())
  quantity  Float
  price     Int
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String          @unique
  amount                Int
  currency              String          @default("bdt")
  provider              PaymentProvider @default(STRIPE)
  status                PaymentStatus   @default(PENDING)
  stripeSessionId       String?         @unique
  stripePaymentIntentId String?         @unique
  paidAt                DateTime?
  buyerId               String?
  order                 Order           @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  buyer                 Buyer?          @relation(fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
}

// =========================
// REVIEW
// =========================

model Review {
  id        String    @id @default(uuid())
  rating    Int
  comment   String?
  buyerId   String
  buyer     Buyer     @relation(fields: [buyerId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orderId   String
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
